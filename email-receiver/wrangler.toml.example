name = "mistflame-email-receiver"
main = "index.ts"
compatibility_date = "2026-04-02"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
preview_urls = false

[[d1_databases]]
binding = "DB"
database_name = "mistflame-db"
database_id = "YOUR_D1_DATABASE_ID"

[[r2_buckets]]
binding = "ATTACHMENTS"
bucket_name = "mistflame-attachments"

[[send_email]]
name = "EMAIL_SENDER"

[[kv_namespaces]]
binding = "KV"
id = "YOUR_KV_NAMESPACE_ID"
preview_id = "local-rate-limit"

[vars]
NOTIFY_ADDRS = ""
# Optional JSON map routing notifications by receiving address: each key is
# one of your inbound addresses, each value the list of addresses to notify.
# An address with no entry notifies all NOTIFY_ADDRS; an empty list mutes it.
# NOTIFY_MAP = '''
# {
#     "alice@example.com": ["alice@gmail.com"],
#     "bob@example.com": ["bob@gmail.com"]
# }
# '''
# Maximum inbound emails accepted in the time window (0 = disabled).
RATE_LIMIT_MAX = "30"
# Time window in minutes.
RATE_LIMIT_WINDOW_MINUTES = "60"
