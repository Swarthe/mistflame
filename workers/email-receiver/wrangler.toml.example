name = "mistflame-email-receiver"
main = "index.ts"
compatibility_date = "2026-04-02"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "mistflame-db"
database_id = "YOUR_D1_DATABASE_ID"

[[r2_buckets]]
binding = "ATTACHMENTS"
bucket_name = "mistflame-attachments"

[[send_email]]
name = "EMAIL_SENDER"

[vars]
NOTIFY_ADDRS = ""
